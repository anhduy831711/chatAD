{
    "compilerOptions": {
        "preserveSymlinks": true,
        "resolveJsonModule": true,
        "baseUrl": "./",
        "target": "es6",
        "module": "commonjs",
        "sourceMap": true,
        "moduleResolution": "node",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "allowSyntheticDefaultImports": true,
        "allowJs": false,
        "removeComments": true,
        "noImplicitAny": false,
        "outDir": "./dist",
        "typeRoots": [
            "./node_modules/@types"
        ],
        "lib": [
            "es2015",
            "es2016",
            "es6",
            "es2017",
            "dom"
        ]
    },
    "include": [
        "index.ts",
        "src/app.ts",
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "src/**/*.spec.ts",
        "src/assets/**",
    ]
}